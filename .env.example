# -----------------------------------------------------------------------------
# Variables de entorno (Vite)
# Copia este archivo como ".env" y ajusta los valores.
# Las variables deben llevar el prefijo VITE_ para ser exposure al cliente.
# -----------------------------------------------------------------------------

# URL base de la API REST (FastAPI).
# Mientras NO se defina, la app usa el catalogo local de src/data/products.json.
# Ejemplo: VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_BASE_URL=https://api.manualidadeslua.com/api

# Duracion de la latencia artificial del modo mock, en milisegundos.
# Solo aplica cuando NO hay VITE_API_BASE_URL definida.
VITE_MOCK_LATENCY=450
